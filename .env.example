# OpenAI API Configuration
OPENAI_API_KEY=your_openai_api_key_here

# Groq API Configuration
GROQ_API_KEY=your_groq_api_key_here

# AWS Configuration (option 1: use a profile - recommended)
AWS_PROFILE=your_aws_profile_name

# AWS Configuration (option 2: use credentials directly)
# AWS_ACCESS_KEY_ID=your_access_key_id
# AWS_SECRET_ACCESS_KEY=your_secret_access_key
# AWS_DEFAULT_REGION=us-east-1

# Optional: Global eval service configuration (can also use eval.yaml in eval directory)
# These override eval.yaml but can be overridden by per-run configs
# EVAL_CHAT_SERVICE=openai
# EVAL_CHAT_MODEL=gpt-4o-mini
# EVAL_EMBED_SERVICE=openai
# EVAL_EMBED_MODEL=text-embedding-3-small

# Optional: API rate limits (requests per minute). Limits get_completion/get_embedding per provider.
# OPENAI_RPM=60
# GROQ_RPM=30
